# Copy to .env and fill in. .env is gitignored and never committed.
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Allowed browser origins for the API. The Streamlit UI calls the API
# server-side, so this only matters for browser tools
CORS_ORIGINS=http://localhost:8501

# https://console.groq.com/keys — free tier, no billing required.
GROQ_API_KEY=

ROUTER_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b
